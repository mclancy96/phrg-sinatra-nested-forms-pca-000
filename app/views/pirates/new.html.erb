<h1>Create a New Pirate</h1>

<%= form_tag "/pirates", method: :post do %>
  <div class="field">
    <%= label_tag "pirate[name]", "Name" %>
    <%= text_field_tag "pirate[name]" %>
  </div>

  <div class="field">
    <%= label_tag "pirate[weight]", "Weight" %>
    <%= text_field_tag "pirate[weight]" %>
  </div>

  <div class="field">
    <%= label_tag "pirate[height]", "Height" %>
    <%= text_field_tag "pirate[height]" %>
  </div>

  <h3>Ship 1</h3>
  <%= text_field_tag "pirate[ships][][name]", "", id: "ship_name_1", placeholder: "Ship Name" %>
  <%= text_field_tag "pirate[ships][][type]", "", id: "ship_type_1", placeholder: "Ship Type" %>
  <%= text_field_tag "pirate[ships][][booty]", "", id: "ship_booty_1", placeholder: "Ship Booty" %>

  <h3>Ship 2</h3>
  <%= text_field_tag "pirate[ships][][name]", "", id: "ship_name_2", placeholder: "Ship Name" %>
  <%= text_field_tag "pirate[ships][][type]", "", id: "ship_type_2", placeholder: "Ship Type" %>
  <%= text_field_tag "pirate[ships][][booty]", "", id: "ship_booty_2", placeholder: "Ship Booty" %>

  <%= submit_tag "Submit" %>
<% end %>
