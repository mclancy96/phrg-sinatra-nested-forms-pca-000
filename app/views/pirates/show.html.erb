<h1>Pirate Details</h1>

<div class="pirate-info">
  <h2>Pirate Information</h2>
  <p><strong>Name:</strong> <%= @pirate.name %></p>
  <p><strong>Weight:</strong> <%= @pirate.weight %></p>
  <p><strong>Height:</strong> <%= @pirate.height %></p>
</div>

<div class="ships-info">
  <h2>Ships</h2>
  <% @ships.each_with_index do |ship, index| %>
    <div class="ship">
      <h3>Ship <%= index + 1 %></h3>
      <p><strong>Name:</strong> <%= ship.name %></p>
      <p><strong>Type:</strong> <%= ship.type %></p>
      <p><strong>Booty:</strong> <%= ship.booty %></p>
    </div>
  <% end %>
</div>
